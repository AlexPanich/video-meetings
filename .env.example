POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
PORT=3001
API_URL=http://localhost:3001

# Каталог хранения загруженных файлов встреч (вне git)
UPLOADS_DIR=./uploads
# Максимальный размер одного файла в байтах (по умолчанию 524288000 = 500 МиБ)
MAX_UPLOAD_BYTES=524288000
