POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=video_meetings
POSTGRES_PORT=5432

# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/video_meetings
# Секрет подписи JWT, не короче 32 байт (иначе API не стартует): openssl rand -base64 48
JWT_SECRET=
# Срок жизни токена: секунды или число с суффиксом s/m/h/d, не больше 24h
JWT_EXPIRES_IN=1h
PORT=3001
# Rate limiting для /auth/login, /auth/register и PUT /profile/password:
# запросов за окно (по IP; по пользователю/email; на входе по паре email+IP считаются неудачные
# попытки) и длина окна в мс
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_TTL_MS=60000
# Сколько прокси стоит перед API (число) или список адресов express; пусто = X-Forwarded-For не доверяем.
# Web (BFF) сам стоит перед API и передаёт ему IP клиента в X-Forwarded-For, поэтому при работе через
# него ставьте 1 и закройте API от прямого доступа извне (иначе заголовок можно подделать).
# Без этого все клиенты считаются одним IP (адресом сервера Next)
TRUST_PROXY=
# Web: сколько обратных прокси стоит перед Next (по ним берётся IP клиента из X-Forwarded-For).
# Пусто/0 = заголовку не доверяем, IP клиента в API не передаётся
TRUSTED_PROXIES=
# Одновременные вычисления scrypt (~128 МиБ каждое) и длина очереди; при переполнении — 503
SCRYPT_CONCURRENCY=2
SCRYPT_QUEUE_LIMIT=32
# Swagger (/docs, /docs-json) выключен, пока явно не включён; в production не включается никогда
SWAGGER_ENABLED=true
API_URL=http://localhost:3001

# Каталог хранения загруженных файлов встреч и аватаров (вне git)
UPLOADS_DIR=./uploads
# Максимальный размер одного файла в байтах (по умолчанию 524288000 = 500 МиБ)
MAX_UPLOAD_BYTES=524288000

# LLM (фасад @video-meetings/llm): local — Qwen в Ollama (по умолчанию), anthropic — Claude Agent SDK
LLM_PROVIDER=local
# Ollama на машине в локальной сети (адрес из PRD; без переменной — http://localhost:11434)
OLLAMA_URL=http://192.168.100.204:11434
OLLAMA_MODEL=qwen3:14b
# Контекст модели в токенах: Ollama молча отбрасывает вход сверх num_ctx
OLLAMA_NUM_CTX=32768
# Таймаут одного запроса к Ollama в мс (по умолчанию 300000 = 5 минут)
OLLAMA_TIMEOUT_MS=300000
# Нужен только при LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
