generator client {
  provider         = "prisma-client"
  output           = "../src/generated/prisma"
  moduleFormat     = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarStorageName String?
  avatarMimeType    String?
  avatarUpdatedAt   DateTime?
  tokenVersion      Int       @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  meetings     Meeting[]
}

model Meeting {
  id           String   @id @default(uuid())
  title        String
  date         DateTime
  participants String[]
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files        MeetingFile[]
  summary      MeetingSummary?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
}

enum FileStatus {
  uploading
  uploaded
  failed
}

model MeetingFile {
  id          String     @id @default(uuid())
  meetingId   String
  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name        String
  storageName String     @unique
  size        Int        @default(0)
  mimeType    String
  status      FileStatus @default(uploading)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([meetingId])
}

// этапы фоновой задачи саммари; `transcribing` появится вместе с транскрибацией (фаза 7)
enum SummaryStatus {
  pending
  generating
  done
  failed
}

// одна запись на встречу: `meetingId` уникален, поэтому активная задача у встречи одна,
// а `result` хранит последнее успешное саммари и меняется только при следующем успехе
model MeetingSummary {
  id        String        @id @default(uuid())
  meetingId String        @unique
  meeting   Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status    SummaryStatus @default(pending)
  result    Json?
  error     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
